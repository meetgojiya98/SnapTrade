# Copy to .env.local for local development. Never commit real secrets.
# OAuth app credentials from a SnapTrade COMMERCIAL workspace > OAuth Apps.
# These are not the Commercial API-key clientId / consumerKey credentials.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CLIENT_SECRET=

# Exact application origin. Register APP_URL + /api/auth/callback in SnapTrade.
# Public deployments require HTTPS; do not include a trailing slash.
APP_URL=http://localhost:3000

# Base64-encoded 32 random bytes. Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=

# Required in production for encrypted sessions, preferences, snapshots and short-lived cache.
# Apply every migration with npm run db:migrate before the first database-backed OAuth login.
# Optional in development when SESSION_STORE=memory is explicitly enabled.
# Use the connection string and TLS settings supplied by your Postgres host.
DATABASE_URL=

# Optional direct/admin connection for migrations; the app only uses DATABASE_URL.
# MIGRATION_DATABASE_URL=

# Development only, selected only when DATABASE_URL is empty.
# Login state and sessions disappear on restart. Never used in production.
SESSION_STORE=memory

# Optional private support operators. Empty or malformed means no operators;
# new support requests remain disabled until at least one operator is configured.
# Comma-separated SHA-256 hashes of `balance:subject:${verified SnapTrade subject}`.
# The signed-in support inbox shows only that viewer's setup key. Verify the
# operator's identity before copying it here; never use an email or client-supplied ID.
# SUPPORT_ADMIN_SUBJECT_HASHES=
